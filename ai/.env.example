# 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채운다. .env 는 Git에 올리지 않는다.
# 비어 있는 값은 코드의 기본값(app/config.py)을 쓴다.

# LLM 호출 방식
#   gms         : SSAFY GMS (OpenAI Responses API 형식, 기본값)
#   openai      : OpenAI 또는 Azure OpenAI v1 주소 (Responses API 형식)
#   openai-chat : Chat Completions 형식 서버 (사내 LLM 서버 vLLM·Ollama, 다른 호환 API)
#   none        : LLM 없이 코드 분석만
#   mock        : 가짜 응답 (자동 테스트 전용)
# 키·주소·모델이 비어 LLM을 부를 수 없으면 분석은 코드 분석만 한다.
AI_ONTOLOGY_LLM_PROVIDER=
# API 키. 채팅·문서·커밋에 붙여 넣지 않는다. 노출되면 새로 발급받는다. openai-chat은 키 없이도 된다.
AI_ONTOLOGY_LLM_API_KEY=
# API 주소. 비우면 gms·openai는 기본 주소. openai-chat은 꼭 채운다 (예: http://llm.internal:8000/v1)
AI_ONTOLOGY_LLM_BASE_URL=
# 모델 이름. 비우면 gms는 gpt-6-luna. openai·openai-chat은 꼭 채운다. 바꾸기 전에 담당자와 협의한다(비용).
AI_ONTOLOGY_LLM_MODEL=
# LLM 응답 대기 시간(초)
AI_ONTOLOGY_LLM_TIMEOUT_SEC=
# 예전 이름 AI_ONTOLOGY_GMS_API_KEY · _BASE_URL · _MODEL 도 그대로 읽는다(새 이름이 우선).

# 분석 결과를 보낼 백엔드 주소 (기본 http://localhost:8080)
AI_ONTOLOGY_BACKEND_URL=
# 백엔드 내부 API(/api/v1/internal/**) 공유 비밀. X-Internal-Token 헤더로 보낸다.
# 서버 ~/axcore/.env에서 AXCORE_INTERNAL_API_TOKEN과 같은 값으로 지정한다. 실제 값은 저장소에 넣지 않는다.
AI_ONTOLOGY_INTERNAL_TOKEN=
