# 로컬·최초 전환용 변수 목록. 운영 비밀값 원본은 Jenkins Credentials(deploy/README.md).
# 운영 .env는 Jenkins 실행용 산출물, 일반 설정은 .env.config에서 관리한다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 배포할 backend 이미지 태그 (= 커밋 SHA 7자리). 5-7부터 Jenkins가 갱신
BACKEND_TAG=
# 배포할 frontend 이미지 태그 (= 커밋 SHA 7자리). 첫 배포는 손으로 넣고, 5-7 확장 뒤 Jenkins가 갱신
FRONTEND_TAG=
# 첫 관리자 계정 (관리자가 없을 때 한 번만 사용). ID는 일반 설정, 비밀번호는 Credentials.
AXCORE_INITIAL_ADMIN_LOGIN_ID=
AXCORE_INITIAL_ADMIN_PASSWORD=
# 내부 API(/api/v1/internal/**) 공유 비밀. 아래 AI_ONTOLOGY_INTERNAL_TOKEN과 같은 값을 넣는다. 비어 있으면 backend가 내부 API를 모두 막는다
AXCORE_INTERNAL_API_TOKEN=
# 원천 접속 비밀번호 암호화 키(32바이트 base64, 예: openssl rand -base64 32). backend·batch에만 넣고 ai에는 넣지 않는다
AXCORE_SOURCE_CREDENTIAL_KEY_1=
# 새로 암호화할 때 쓰는 키 버전. 비우면 1. 키를 바꿀 때만 올린다
AXCORE_SOURCE_CREDENTIAL_KEY_VERSION=

# AI 이미지 태그 (= 커밋 SHA). 첫 배포 시 지정
AI_TAG=

# AI 설정. 일반 설정은 .env.config, API 키는 별도 Credentials 등록 후 연결한다.
AI_ONTOLOGY_LLM_PROVIDER=
AI_ONTOLOGY_LLM_API_KEY=
AI_ONTOLOGY_LLM_BASE_URL=
AI_ONTOLOGY_LLM_MODEL=
AI_ONTOLOGY_LLM_TIMEOUT_SEC=
AI_ONTOLOGY_INTERNAL_TOKEN=

# Grafana 최초 관리자 계정. ID는 일반 설정, 비밀번호는 Credentials.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
