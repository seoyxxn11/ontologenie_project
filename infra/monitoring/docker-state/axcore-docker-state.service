[Unit]
Description=AXCORE Docker state metrics collection
After=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/axcore
ExecStart=/usr/bin/python3 /home/ubuntu/axcore/monitoring/docker-state/collect.py --project axcore --host-network
TimeoutStartSec=25s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/axcore/monitoring/textfile
