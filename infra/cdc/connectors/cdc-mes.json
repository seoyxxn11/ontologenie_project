{
  "name": "cdc-mes",
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "3.34.192.251",
  "database.port": "15432",
  "database.dbname": "mes",
  "database.user": "platform_cdc",
  "database.password": "${env:MES_CDC_PASSWORD}",
  "database.sslmode": "require",
  "topic.prefix": "MES_MAIN",
  "slot.name": "axcore_mes",
  "publication.name": "axcore_cdc",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "no_data",
  "table.exclude.list": "mes.change_log",
  "column.exclude.list": "mes.worker.name",
  "decimal.handling.mode": "string",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "60000",
  "provide.transaction.metadata": "true",
  "skipped.operations": "none",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "(MES_MAIN[.].*|__debezium-heartbeat[.]MES_MAIN)",
  "transforms.route.replacement": "MES_MAIN.all"
}
